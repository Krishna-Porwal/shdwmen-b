{
  "name": "shdwmen-backend",
  "version": "1.0.0",
  "description": "Backend API for ShadowMen e-commerce platform",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest --runInBand",
    "type-check": "tsc --noEmit",
    "migrate": "node -r ts-node/register src/db/migrate.ts",
    "drizzle:generate": "drizzle-kit generate",
    "drizzle:migrate": "drizzle-kit migrate",
    "drizzle:migrate:checked": "node scripts/run-migrations-checked.js",
    "backfill:sold-count": "ts-node scripts/backfill-sold-count.ts",
    "setup-merchant": "ts-node setup-demo-merchant.ts"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/tests/**/*.test.ts"
    ]
  },
  "dependencies": {
    "@clerk/backend": "^1.14.1",
    "@types/multer": "^1.4.12",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.2",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "drizzle-orm": "^0.45.2",
    "express": "^4.18.2",
    "express-rate-limit": "^6.11.2",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.0",
    "multer": "^2.2.0",
    "pg": "^8.11.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "razorpay": "^2.9.2",
    "typescript": "^5.3.3",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.3",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.11.4",
    "@types/supertest": "^2.0.12",
    "@types/uuid": "^9.0.7",
    "drizzle-kit": "^0.31.10",
    "jest": "^29.6.1",
    "nodemon": "^3.0.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2"
  }
}
